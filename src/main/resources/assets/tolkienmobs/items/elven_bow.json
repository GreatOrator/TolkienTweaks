{
  "model": {
    "type": "minecraft:condition",
    "property": "tolkienmobs:pulling",
    "on_false": {
      "type": "minecraft:model",
      "model": "tolkienmobs:item/elven_bow"
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "tolkienmobs:pull",
      "entries": [
        { "threshold": 0.65, "model": { "type": "minecraft:model", "model": "tolkienmobs:item/elven_bow_pulling_1" } },
        { "threshold": 0.9, "model": { "type": "minecraft:model", "model": "tolkienmobs:item/elven_bow_pulling_2" } }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "tolkienmobs:item/elven_bow_pulling_0"
      }
    }
  }
}
